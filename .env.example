# Optional. Only needed if you want to load an analytics script (e.g. Umami).
# Leave unset (or delete this file) to skip analytics entirely — the site
# works fine without it.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional. Base URL for a future, separately-hosted Tool2U backend
# for the AI developer tools (explain/review/optimize/etc — see
# client/src/lib/api/apiClient.js). Leave unset to keep those specific tools
# showing a "coming soon" state. This does NOT affect the Online Code
# Editor's Run button — that's handled by the /api/execute serverless
# function below, which is same-origin and needs no base URL.
VITE_API_BASE_URL=

# ============================================================
# Server-side only (Phase 3: code execution API, /api/execute)
# Do NOT prefix these with VITE_ — that would bundle them into the
# frontend JS and expose them publicly. Vercel serverless functions
# (files under /api) read these directly from process.env at runtime.
# ============================================================

# Base URL of the Judge0 instance used to actually run submitted code.
# Defaults to the public Judge0 CE instance (https://ce.judge0.com) if unset.
# For production, prefer a keyed instance (RapidAPI-hosted Judge0, or your
# own self-hosted deployment) for reliability and higher rate limits.
JUDGE0_API_URL=

# If using RapidAPI-hosted Judge0 CE, set both of these (from your RapidAPI
# dashboard). Leave both blank when using an unauthenticated instance.
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# If using a self-hosted Judge0 instance with AUTHN_TOKEN enabled, set this
# to that token instead of the RapidAPI variables above.
JUDGE0_AUTH_TOKEN=

# Optional resource-limit overrides for every execution request (all have
# sane defaults — see server/execution/judge0Client.js). The client can
# never override these; they're enforced entirely server-side.
EXEC_CPU_TIME_LIMIT_SECONDS=
EXEC_WALL_TIME_LIMIT_SECONDS=
EXEC_MEMORY_LIMIT_KB=
EXEC_MAX_OUTPUT_KB=
EXEC_MAX_CODE_LENGTH=
EXEC_MAX_STDIN_LENGTH=
EXEC_RATE_LIMIT_WINDOW_MS=
EXEC_RATE_LIMIT_MAX=
